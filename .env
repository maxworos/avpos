# AV-POS Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=mysql://username:password@host:port/database

# App Secrets
APP_ID=avpos-production-app
APP_SECRET=your-super-secret-jwt-key-change-this

# Node Environment
NODE_ENV=production

# Port (Railway sets this automatically)
PORT=3000
